# Copy to .env (git-ignored) and fill in. Placeholders only, never commit real values.

# --- Variables the code reads today ---
# Gemini API key (AI Studio). Read by agents/orchestrator.py and adk_verifier.py.
# Leave empty to run in deterministic-only mode.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override. Confirm the ID is currently available before relying on it.
GEMINI_MODEL=gemini-2.5-flash
PORT=8000

# Separate verifier service (optional). If set, all verification runs there and FAILS CLOSED if it is down.
# VERIFIER_URL=http://127.0.0.1:8100

# --- Vertex AI instead of an API key (cloud). Uses Application Default Credentials. ---
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
